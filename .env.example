# =============================================================================
# .env.example
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# =============================================================================

# --- Ollama (local) ---
# Embedding model served by Ollama. Change if you swap the model.
EMBEDDING_MODEL=qwen3-embedding:0.6b-q8_0

# --- Qdrant: choose ONE of the two blocks below ---

# Option A: Self-hosted single-node via Docker Compose (this branch default)
#   1. docker compose up -d
#   2. python data/run_ingest_lc.py    (one-time; data persists in Docker volume)
#   3. python main.py query "..."
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_LC=compliance_agent_lc
QDRANT_API_KEY=
USE_QDRANT=1
QDRANT_VECTOR_DIM=1024

# Option B: Qdrant Cloud
#   Get these from console.qdrant.tech → your cluster → API Keys
# QDRANT_URL=https://<cluster-id>.qdrant.tech
# QDRANT_COLLECTION_LC=compliance_agent_lc
# QDRANT_API_KEY=<your-qdrant-api-key>
# USE_QDRANT=1
# QDRANT_VECTOR_DIM=1024

# --- Langfuse ---
# Get these from cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Reranker ---
# Qwen3-Reranker is downloaded from HuggingFace on first use (~1.5 GB).
# Set USE_RERANKER=0 to disable and fall back to plain vector search.
USE_RERANKER=1
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# --- law.go.kr DRF Open API ---
# Required only for re-scraping (data/raw/ cache covers normal runs).
# Get yours at open.law.go.kr → 마이페이지 → OC 발급. Server IP must be
# registered. Auth failure surfaces as "사용자 정보 검증에 실패하였습니다."
DRF_OC=
