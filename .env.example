# =============================================================================
# .env.example
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# Two runtime modes:
#   Local dev  : set Ollama vars; leave LLM_API_BASE / EMBED_API_BASE empty.
#   Production : set LLM_API_BASE / EMBED_API_BASE; Ollama vars are unused.
# =============================================================================

# --- LLM inference (production: vLLM on GPU EC2) ---
# Leave LLM_API_BASE empty to fall back to Ollama for local development.
LLM_API_BASE=                          # http://<vllm-host>:8000/v1
LLM_MODEL=Qwen3-8B                     # must match --served-model-name in vllm docker run
LLM_API_KEY=EMPTY                      # "EMPTY" is the vLLM default; set for auth-enabled servers

# --- Embedding inference (production: vLLM --task embed or TEI on GPU EC2) ---
# Leave EMBED_API_BASE empty to fall back to Ollama for local development.
EMBED_API_BASE=                        # http://<vllm-host>:8001/v1
EMBED_MODEL=qwen3-embedding-0.6B       # must match --served-model-name
EMBED_API_KEY=EMPTY

# --- Ollama (local dev only — ignored when LLM_API_BASE / EMBED_API_BASE are set) ---
# Embedding model served by Ollama. Change if you swap the model.
EMBEDDING_MODEL=qwen3-embedding:0.6b-q8_0

# --- Qdrant Cloud ---
# Get these from console.qdrant.tech → your cluster → API Keys
QDRANT_URL=https://<cluster-id>.qdrant.tech
QDRANT_COLLECTION=compliance_agents
QDRANT_API_KEY=<your-qdrant-api-key>   # store in AWS Secrets Manager for ECS
# Set USE_QDRANT=0 to skip Qdrant entirely and use an in-memory vector store instead.
USE_QDRANT=1
QDRANT_VECTOR_DIM=1024  # embedding output dimension; update if you change the embedding model

# --- Langfuse ---
# Get these from cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...          # store in AWS Secrets Manager for ECS
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Reranker (in-process, CPU, baked into the Docker image) ---
# Set USE_RERANKER=0 to disable and fall back to plain vector search.
USE_RERANKER=1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- law.go.kr DRF Open API ---
# Required only for re-scraping (data/raw/ cache covers normal runs).
# Get yours at open.law.go.kr → 마이페이지 → OC 발급. Server IP must be
# registered. Auth failure surfaces as "사용자 정보 검증에 실패하였습니다."
DRF_OC=
